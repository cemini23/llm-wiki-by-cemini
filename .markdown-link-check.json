{
  "ignorePatterns": [
    { "pattern": "^mailto:" },
    { "pattern": "^http://localhost" },
    { "pattern": "^https?://127\\.0\\.0\\.1" },
    { "pattern": "^file://" },
    { "pattern": "^@" }
  ],
  "httpHeaders": [
    {
      "urls": ["https://github.com"],
      "headers": {
        "User-Agent": "Mozilla/5.0 (compatible; markdown-link-check)"
      }
    }
  ],
  "timeout": "30s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 301, 302, 303, 307, 308]
}
