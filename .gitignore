# =============================================================================
# Cemini OSINT Research Workspace — .gitignore
# =============================================================================
# Tracked: CLAUDE.md, LESSONS.md, README.md, wiki/, scripts/, .gitignore
# Untracked: raw sources, market data, briefs, server credentials, OS cruft
# =============================================================================

# --- Raw sources (large, copyrighted, immutable; live local only) ------------
research for cemini/
research to be indexed/
market dataset/

# --- Outputs staged for distribution (operational; contain server IPs) -------
briefs/

# --- Server credentials & connection details (local-only) --------------------
.local/

# --- Cursor lazy-tool local catalog (regenerable via lazy-tool reindex) ---------
.cursor/lazy-tool-catalog.db
.cursor/lazy-tool-catalog.db-*
.cursor/vector/

# --- Claude Code per-project state (settings, lock files, scheduled-task state) ----
.claude/

# --- Playwright MCP session artifacts (console logs, page snapshots) ----------
.playwright-mcp/

# --- codegraph indices (per-project AST + symbol SQLite, regenerable on init) -----
.codegraph/
*.codegraph.sqlite
*.codegraph.sqlite-journal

# --- Session-state cache (changes every session; ephemeral curator working memory) --
hot.md

# --- Generated wiki-health report (regenerated by scripts/wiki_scan_all.py --write) --
WIKI_HEALTH.md

# --- macOS / editor cruft -----------------------------------------------------
.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/
.obsidian/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/
.pytest_cache/

# --- Node.js (not a Node project; root-level installs are accidental) ----------
node_modules/
package.json
package-lock.json

# --- Environment variables (secrets; .env.example is the committed template) ----
.env

# --- Temp scratch -------------------------------------------------------------
/tmp_*.txt
/tmp_*.md
*.tmp

# Rewind
.rewind-brief.md
.agents/
skills-lock.json
