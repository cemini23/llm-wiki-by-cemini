[Unit]
Description=Cemini dev.fun Poker Arena monitor (analyze + eval poll)
Documentation=https://docs.dev.fun/
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/devfun-poker-arena
Environment=PYTHONUNBUFFERED=1
Environment=ARENA_MONITOR_REPORTS_DIR=/opt/devfun-poker-arena/reports
EnvironmentFile=-/opt/cemini/.env
EnvironmentFile=-/opt/devfun-poker-arena/.env
# HL auto-analyst: DEEPSEEK_API_KEY + OPENROUTER_API_KEY (often in /opt/cemini/.env).
# LLM_FALLBACK_ENABLED=1 (default): OpenRouter only after DeepSeek quota/outage — not parallel.
ExecStart=/opt/devfun-poker-arena/venv/bin/python examples/arena_monitor.py once
UMask=0077

[Install]
WantedBy=multi-user.target
