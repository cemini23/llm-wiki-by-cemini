[Unit]
Description=Queue mixed-size sweep after in-flight primary sweep
Documentation=file:///opt/devfun-poker-arena-train/README-CEMINI.md
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/devfun-poker-arena-train
ExecStart=/opt/devfun-poker-arena-train/examples/wait_then_run_mixed_sweep.sh
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
