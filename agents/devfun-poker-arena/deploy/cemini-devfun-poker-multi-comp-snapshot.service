[Unit]
Description=Cemini multi-comp oracle snapshot (S1 tournament primary + S2 intel)
Documentation=https://docs.dev.fun/
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/devfun-poker-arena
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/opt/devfun-poker-arena/.env
ExecStart=/opt/devfun-poker-arena/venv/bin/python examples/multi_comp_registry.py snapshot --export
UMask=0077

[Install]
WantedBy=multi-user.target
