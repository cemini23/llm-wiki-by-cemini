[Unit]
Description=Cemini poker mixed table-size sweep (6/4/2-max after primary)
Documentation=file:///opt/devfun-poker-arena-train/README-CEMINI.md
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/devfun-poker-arena-train
Environment=PYTHONUNBUFFERED=1
Environment=SWEEP_HANDS=1500
Environment=SWEEP_PROFILES=named+grid+seats
Environment=SWEEP_PLAYER_SIZES=6,4,2
Environment=SWEEP_PLAYER_WEIGHTS=6:0.55,4:0.25,2:0.20
Environment=SWEEP_SEED=
Environment=REPORT_DIR=/opt/devfun-poker-arena-train/reports/sweep-mixed
ExecStart=/opt/devfun-poker-arena-train/examples/run_train_sweep_mixed.sh
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
