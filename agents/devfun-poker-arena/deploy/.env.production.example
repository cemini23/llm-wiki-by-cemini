# Production env for cemini-prod (/opt/devfun-poker-arena/.env)
# Copy to server as .env — credentials also in .arena-credentials

# Official production arena (NOT b-arena beta)
ARENA_API_BASE=https://arena.dev.fun/api/arena
ARENA_LOBBY_COMPETITION_ID=cmpy2qy65002ud9ej6b7jjq0l

# Poker Eval IDs watched by arena_monitor.py (comma-separated)
ARENA_EVAL_COMPETITION_IDS=cmpdk0pt00eawvcaf1es8plw2,cmpkdus9200syw8do5644oymp
ARENA_MONITOR_REPORTS_DIR=/opt/devfun-poker-arena/reports

# Optional override if not using .arena-credentials
# ARENA_API_KEY=arena_sk_...

# ── Playground pace / protect (see ROADMAP W6) ───────────────────────────────
# S1a build mode (Jun 3–7): preserve buffer, prioritize HL analyze signal.
# S1b compete mode (Jun 7–11): tighten pace before KO — see ROADMAP flip table.
CEMINI_FIRST_RANK=1
CEMINI_FIRST_JOIN_RETRY_S=1800
CEMINI_LEAD_JOIN_RETRY_S=600
CEMINI_QUAL_JOIN_RETRY_S=300
# Staggered bankroll locks — ratios vs live cutoff/qual floor (qualification_guard.py).
CEMINI_STAGGER_LOCKS=1
# Rank #1: lock at least this fraction of surplus above qual floor (default 0.80).
# CEMINI_FIRST_LOCK_SURPLUS_PCT=0.80
# Rank #1: cap playable stack to this fraction of total (default 0.28).
# CEMINI_FIRST_MAX_PLAYABLE_FRAC=0.28
# Optional legacy absolute floor — prefer ratios; set per tournament on prod only.
# CEMINI_CHIP_RESERVE=
# CEMINI_FIRST_RANK=2
# CEMINI_LEAD_JOIN_RETRY_S=900

# River unbeatable detection (hand_nuts.py → cemini_decide.py).
CEMINI_NUTS_DETECT=1

# HL R21 — survival lane (S1a synthesis)
CEMINI_COLD_START_NO_STEAL=1
CEMINI_NEMESIS_TIGHT=1
CEMINI_NEMESIS_HANDLES=hunterguy102,thaddius
CEMINI_LOW_STACK_JOIN_RETRY_S=3600

# Reset / KO hour-one — survival until 200 hands or 2k chips (new comp auto-resets counter)
CEMINI_KO_SURVIVAL=1
CEMINI_KO_SURVIVAL_HANDS=200
CEMINI_KO_SURVIVAL_MIN_STACK=2000

# ── Researcher Round (HU sandbox / Jun21 beta) ───────────────────────────────
# CEMINI_PRIMARY_TRACK=researcher
# CEMINI_TABLE_FORMAT=hu
# CEMINI_RESEARCHER_MODE=1
# CEMINI_TRAJECTORY_BOUND=1
# CEMINI_VERIFIER_BON=1   # K123 marginal-postflop BoN (pairs with trajectory bound)
# CEMINI_SANITIZE_OUTPUT=1
