[Unit]
Description=Cemini dev.fun full-field data crawl (batched submissions + all agent stats)
Documentation=https://docs.dev.fun/
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/opt/devfun-poker-arena
Environment=PYTHONUNBUFFERED=1
Environment=CEMINI_EXPORT_DIR=/opt/devfun-poker-arena/reports/exports/s1-tournament-live
Environment=CEMINI_EXPORT_SHARD_INDEX=0
Environment=CEMINI_EXPORT_SHARD_COUNT=3
EnvironmentFile=-/opt/devfun-poker-arena/.env
# Checkpoint by stable agent_id set (not rank offset). Skip tables — hourly job owns those.
ExecStart=/bin/bash -c '/opt/devfun-poker-arena/venv/bin/python examples/export_field_crawl.py --out-dir ${CEMINI_EXPORT_DIR:-/opt/devfun-poker-arena/reports/exports/s1-tournament-live} --match ${S1_TOURNAMENT_COMP:-${ARENA_LOBBY_COMPETITION_ID}} --batch-size 120 --sleep 0.04 --no-tables --shard-index ${CEMINI_EXPORT_SHARD_INDEX:-0} --shard-count ${CEMINI_EXPORT_SHARD_COUNT:-3}'
UMask=0077

[Install]
WantedBy=multi-user.target
