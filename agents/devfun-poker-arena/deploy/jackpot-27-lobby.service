[Unit]
Description=Cemini dev.fun S2 jackpot satellite (72o bluff hunt)
Documentation=https://docs.dev.fun/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/devfun-poker-arena
Environment=PYTHONUNBUFFERED=1
Environment=ARENA_CREDENTIALS_FILE=.arena-credentials.jackpot-probe
Environment=JACKPOT_27_JOIN_ENABLED=0
Environment=JACKPOT_27_HUNT_ENABLED=0
Environment=JACKPOT_27_MAX_ATTEMPTS=3
Environment=JACKPOT_27_COMPETITION_ID=
ExecStart=/opt/devfun-poker-arena/venv/bin/python examples/run_jackpot_27_lobby.py
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
