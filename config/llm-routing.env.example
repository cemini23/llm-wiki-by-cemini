# Cemini cross-project LLM routing — DeepSeek primary, OpenRouter fallback
#
# Install once (recommended):
#   cp config/llm-routing.env.example ~/.cemini/llm-routing.env
#   # edit keys in ~/.cemini/llm-routing.env (never commit)
#
# Per session / per project:
#   source scripts/source_llm_routing_env.sh
#
# Consumers: OSINT scripts (_llm_retry, skill_audit), CeminiSuite llm_analyst,
# world-cup-bot ADVISOR_*, conductor, any OpenAI-compatible tooling.

# ── Primary (DeepSeek brain) ─────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# ── Fallback (OpenRouter — when DeepSeek quota/balance exhausted) ───
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Map deepseek-v4-flash → deepseek/deepseek-chat on OR unless overridden:
LLM_FALLBACK_MODEL=deepseek/deepseek-chat
# Set false to disable failover even when OPENROUTER_API_KEY is set:
LLM_FALLBACK_ENABLED=true

# Optional OpenRouter attribution headers
OPENROUTER_HTTP_REFERER=https://github.com/cemini23
OPENROUTER_APP_TITLE=Cemini

# Role-specific overrides (optional — scripts may read these later)
# LLM_FALLBACK_MODEL_CODING=moonshotai/kimi-k2.6
# LLM_FALLBACK_MODEL_ADVISOR=google/gemini-2.5-flash

# ── World Cup Bot advisor (auto-filled if unset when sourcing this file) ─
# ADVISOR_BASE_URL=https://openrouter.ai/api/v1
# ADVISOR_API_KEY=${OPENROUTER_API_KEY}
# ADVISOR_MODEL=google/gemini-2.5-flash
