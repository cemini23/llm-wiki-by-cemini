{
  "mcpServers": {
    "conductor": {
      "type": "stdio",
      "command": "python3",
      "args": ["conductor/mcp_server.py"],
      "env": {}
    },
    "kb-server": {
      "type": "stdio",
      "command": "ssh",
      "args": ["cemini-librarian", "cd /opt/cemini-wiki && KB_TOOL_ALLOWLIST=kb_search,kb_search_smart,kb_context,kb_read,kb_list,kb_vault_status,kb_safety_check node /opt/kb-server/src/mcp.js"],
      "env": {}
    },
    "prod-mcp": {
      "type": "sse",
      "url": "http://localhost:18002/mcp"
    },
    "librarian-stash": {
      "type": "sse",
      "url": "http://localhost:18080/sse"
    },
    "lazy-tool": {
      "type": "stdio",
      "command": "/Users/claudiobarone/.local/bin/lazy-tool",
      "args": ["--config", "/Users/claudiobarone/.lazy-tool/config.yaml", "serve"],
      "env": {
        "LAZY_TOOL_CONFIG": "/Users/claudiobarone/.lazy-tool/config.yaml"
      }
    }
  },
  "environments": [
    {
      "name": "local",
      "mcpServers": ["conductor", "kb-server"]
    },
    {
      "name": "prod",
      "description": "CeminiSuite production (Hetzner 5.161.53.103) — requires SSH tunnel first: cemini-tunnel open prod",
      "mcpServers": ["prod-mcp"]
    },
    {
      "name": "librarian",
      "description": "Cemini librarian (Hetzner 5.161.179.207) — requires SSH tunnel first: cemini-tunnel open librarian",
      "mcpServers": ["kb-server", "librarian-stash"]
    },
    {
      "name": "lazy",
      "description": "lazy-tool MCP proxy — 5 meta-tools replacing 150+ direct schemas. Run 'lazy-tool reindex' after opening tunnels to refresh catalog.",
      "mcpServers": ["lazy-tool"]
    }
  ]
}
