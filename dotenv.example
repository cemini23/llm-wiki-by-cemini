# Cemini Conductor — environment variables
# Copy this to .env and fill in real values.
# .env is gitignored; this template is committed.

# DeepSeek API (required for all LLM calls)
DEEPSEEK_API_KEY=sk-your-deepseek-key

# Librarian kb-server (required for wiki search / context tools)
LIBRARIAN_API_KEY=your-kb-server-key
LIBRARIAN_BASE_URL=http://10.0.0.2:3838
LIBRARIAN_TIMEOUT_S=3.0
